# App Store listing and submission, run by .github/workflows/app-store.yml.
# Uses an App Store Connect API key from repo secrets (ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8).

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      in_house: false
    )
  end

  # Listing text, review notes, demo login and screenshots; submits for review when SUBMIT=true.
  lane :listing do
    submit = ENV["SUBMIT"] == "true"
    deliver(
      api_key: asc_key,
      app_identifier: "com.tommybruggeman.legacydynasty",
      app_version: ENV.fetch("APP_VERSION", "1.0.0"),
      build_number: ENV["BUILD_NUMBER"],
      platform: "ios",
      metadata_path: "store/metadata",
      screenshots_path: "store/screenshots",
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_app_version_update: false,
      app_rating_config_path: "store/age_rating.json",
      submit_for_review: submit,
      automatic_release: true,
      reject_if_possible: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: submit,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: true,
        content_rights_has_rights: true
      }
    )
  end
end
