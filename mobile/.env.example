# Copy to .env.local (git-ignored). Both values are public: the anon key only
# gets what row-level security allows for the signed-in owner. Never put the
# service-role key or the Anthropic key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The Legacy API server on Google Cloud Run.
EXPO_PUBLIC_API_URL=https://legacy-api-94901925561.us-central1.run.app
